{% comment %}
  v484 · CREATE YOUR OWN — wizard cá nhân hoá sách trên talewix.com (chạy cùng FUSION Studio).

  CÀI ĐẶT (1 lần):
    1. Shopify admin → Online Store → Themes → Edit code → Templates → Add a new template
       → chọn "page", đặt suffix: create-your-own, loại Liquid → dán TOÀN BỘ file này vào.
    2. Online Store → Pages → Add page: Title "Create Your Own", Template: page.create-your-own → Save.
    3. Navigation → main menu → thêm item "Create Your Own ✨" → link tới page vừa tạo.
    4. Trong FUSION → Seller Hub → Shopify → Create Your Own: bật Enable + thêm template + chọn model.
  Link chọn sẵn template (giống Printerval): /pages/create-your-own?template=<template_id>
{% endcomment %}

<div id="cyo-app">
  <style>
    #cyo-app { max-width: 980px; margin: 0 auto; padding: 24px 16px 60px; font-family: inherit; }
    #cyo-app * { box-sizing: border-box; }
    .cyo-head { text-align: center; margin-bottom: 26px; }
    .cyo-head h1 { font-size: 30px; margin: 0 0 8px; }
    .cyo-head p { color: #666; margin: 0; font-size: 15px; }
    .cyo-steps { display: flex; justify-content: center; gap: 6px; margin: 18px 0 26px; flex-wrap: wrap; }
    .cyo-step { font-size: 12.5px; font-weight: 700; padding: 6px 14px; border-radius: 99px; background: #f4f4f4; color: #999; }
    .cyo-step.on { background: #f68b1e; color: #fff; }
    .cyo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
    .cyo-card { border: 2px solid #eee; border-radius: 14px; padding: 10px; cursor: pointer; text-align: center; transition: border-color .15s; background: #fff; }
    .cyo-card:hover { border-color: #f6b26e; }
    .cyo-card.sel { border-color: #f68b1e; box-shadow: 0 0 0 3px rgba(246,139,30,.15); }
    .cyo-card img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; }
    .cyo-card .t { font-weight: 700; font-size: 13.5px; margin: 8px 0 2px; }
    .cyo-card .p { color: #f68b1e; font-weight: 800; font-size: 13px; }
    .cyo-panel { background: #fff; border: 1px solid #eee; border-radius: 16px; padding: 22px; max-width: 560px; margin: 0 auto; }
    .cyo-lbl { display: block; font-weight: 700; font-size: 13.5px; margin: 16px 0 6px; }
    .cyo-inp { width: 100%; padding: 12px 14px; border: 1px solid #ddd; border-radius: 10px; font-size: 15px; }
    .cyo-drop { border: 2px dashed #ddd; border-radius: 12px; padding: 26px; text-align: center; cursor: pointer; color: #888; font-size: 14px; transition: border-color .15s; }
    .cyo-drop:hover { border-color: #f68b1e; }
    .cyo-drop img { max-width: 130px; border-radius: 10px; display: block; margin: 0 auto 8px; }
    .cyo-btn { display: inline-block; background: #f68b1e; color: #fff !important; border: 0; border-radius: 12px; padding: 14px 30px; font-size: 15.5px; font-weight: 800; cursor: pointer; text-decoration: none; }
    .cyo-btn[disabled] { opacity: .5; cursor: not-allowed; }
    .cyo-btn.alt { background: #14213D; }
    .cyo-note { font-size: 12.5px; color: #999; margin-top: 10px; }
    .cyo-err { background: #fdecec; color: #c0392b; border-radius: 10px; padding: 10px 14px; font-size: 13.5px; margin-top: 12px; display: none; }
    .cyo-gen { text-align: center; padding: 30px 10px; }
    .cyo-bar { height: 8px; background: #f4f4f4; border-radius: 99px; overflow: hidden; margin: 18px auto 8px; max-width: 380px; }
    .cyo-bar i { display: block; height: 100%; width: 0%; background: #f68b1e; border-radius: 99px; transition: width .8s ease; }
    .cyo-preview img { width: 100%; max-width: 440px; border-radius: 14px; border: 1px solid #eee; display: block; margin: 0 auto 16px; }
    .cyo-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
    .cyo-actions { text-align: center; margin-top: 22px; }
    @media (max-width: 560px) { .cyo-head h1 { font-size: 24px; } .cyo-panel { padding: 16px; } }
  </style>

  <div class="cyo-head">
    <h1>Create Your Own Storybook</h1>
    <p>Pick a book, add your child's name and photo — see their cover in about a minute. Free, no card needed.</p>
    <div class="cyo-steps">
      <span class="cyo-step" data-step="1">1 · Choose a book</span>
      <span class="cyo-step" data-step="2">2 · Personalize</span>
      <span class="cyo-step" data-step="3">3 · Your preview</span>
    </div>
  </div>

  <!-- STEP 1: chọn template -->
  <div id="cyo-s1">
    <div class="cyo-grid" id="cyo-templates"><div style="color:#999">Loading books…</div></div>
  </div>

  <!-- STEP 2: tên + ảnh -->
  <div id="cyo-s2" style="display:none">
    <div class="cyo-panel">
      <div id="cyo-chosen" style="display:flex;align-items:center;gap:12px"></div>
      <label class="cyo-lbl">Child's name (as it appears on the cover)</label>
      <input class="cyo-inp" id="cyo-name" maxlength="40" placeholder="e.g. James" autocomplete="off">
      <label class="cyo-lbl">Child's age <span style="font-weight:400;color:#999">(optional — helps us personalize the story)</span></label>
      <select class="cyo-inp" id="cyo-age">
        <option value="">— select age —</option>
        <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option>
        <option>7</option><option>8</option><option>9</option><option>10</option><option>11</option><option>12</option>
      </select>
      <label class="cyo-lbl">Child's photo (one clear face photo)</label>
      <div class="cyo-drop" id="cyo-drop">
        <span id="cyo-drop-empty">📷 Click to upload a photo<br><span style="font-size:12px;color:#aaa">Best results: clear, front-facing, good light — no sunglasses, no side angles</span></span>
        <span id="cyo-drop-full" style="display:none"></span>
      </div>
      <input type="file" id="cyo-file" accept="image/*" style="display:none">
      <div class="cyo-note">🔒 Your child's photo is used only to create this preview — it is never stored on our servers or shown to anyone else.</div>
      <div class="cyo-err" id="cyo-err2"></div>
      <div class="cyo-actions">
        <button class="cyo-btn" id="cyo-gen-btn" disabled>Create my free preview →</button><br>
        <a href="#" id="cyo-back1" style="font-size:13px;color:#999;display:inline-block;margin-top:12px">← Choose a different book</a>
      </div>
    </div>
  </div>

  <!-- STEP 3a: đang gen -->
  <div id="cyo-s3" style="display:none">
    <div class="cyo-panel cyo-gen">
      <h2 style="margin:0 0 6px" id="cyo-gen-title">Creating the cover…</h2>
      <p style="color:#888;font-size:14px;margin:0">Usually 30–60 seconds. Please keep this page open.</p>
      <div class="cyo-bar"><i id="cyo-bar-i"></i></div>
      <div style="font-size:12.5px;color:#aaa" id="cyo-elapsed">0s</div>
    </div>
  </div>

  <!-- STEP 3b: preview -->
  <div id="cyo-s4" style="display:none">
    <div class="cyo-panel cyo-preview">
      <h2 style="text-align:center;margin:0 0 14px">Here's the preview! 🎉</h2>
      <img id="cyo-result" alt="Your personalized cover preview">
      <div class="cyo-row" style="margin-bottom:14px">
        <input class="cyo-inp" id="cyo-email" type="email" placeholder="Email — we'll save this preview for you" style="flex:1;min-width:200px">
        <button class="cyo-btn alt" id="cyo-save-btn" style="padding:12px 18px;font-size:13.5px">Save it</button>
      </div>
      <div class="cyo-note" id="cyo-save-note" style="text-align:center;display:none">✓ Saved — check your inbox soon.</div>
      <div class="cyo-err" id="cyo-err4"></div>
      <div class="cyo-actions">
        <button class="cyo-btn" id="cyo-cart-btn">Order the printed book <span id="cyo-cart-price"></span> →</button><br>
        <a href="#" id="cyo-retry" style="font-size:13px;color:#999;display:inline-block;margin-top:12px">↻ Try a different photo or book</a>
      </div>
      <div class="cyo-note" style="text-align:center">The watermark is removed on the printed book. You'll review and approve your book before we print — changes are free at that stage.</div>
    </div>
  </div>
</div>

<script>
(function () {
  // ⚙️ CHỈNH 1 DÒNG NÀY nếu domain FUSION thay đổi:
  var API = "https://os.fusiondn.com/api/studio/public";

  var S = { templates: [], tpl: null, photo: "", previewId: "", previewUrl: "", timer: null, t0: 0 };
  var $ = function (id) { return document.getElementById(id); };
  function show(step) {
    ["cyo-s1", "cyo-s2", "cyo-s3", "cyo-s4"].forEach(function (id, i) { $(id).style.display = (i === step - 1) ? "" : "none"; });
    var on = step >= 4 ? 3 : step;
    document.querySelectorAll(".cyo-step").forEach(function (el) { el.classList.toggle("on", Number(el.dataset.step) <= on); });
    window.scrollTo({ top: 0, behavior: "smooth" });
  }
  function err(id, m) { var el = $(id); el.textContent = m || ""; el.style.display = m ? "" : "none"; }

  // ── STEP 1: load templates (?template=<id> → chọn sẵn kiểu Printerval) ──
  fetch(API).then(function (r) { return r.json(); }).then(function (j) {
    var box = $("cyo-templates");
    if (!j.ok || !j.templates || !j.templates.length) { box.innerHTML = '<div style="color:#999">Our studio is temporarily unavailable — please check back soon.</div>'; return; }
    S.templates = j.templates;
    box.innerHTML = "";
    j.templates.forEach(function (t) {
      var d = document.createElement("div");
      d.className = "cyo-card"; d.dataset.id = t.id;
      d.innerHTML = '<img src="' + t.thumbUrl + '" alt="" loading="lazy"><div class="t"></div><div class="p"></div>';
      d.querySelector(".t").textContent = t.title;
      d.querySelector(".p").textContent = t.price || "";
      d.addEventListener("click", function () { pick(t); });
      box.appendChild(d);
    });
    var pre = new URLSearchParams(location.search).get("template");
    if (pre) { var m = j.templates.filter(function (t) { return t.id === pre; })[0]; if (m) pick(m); }
  }).catch(function () { $("cyo-templates").innerHTML = '<div style="color:#999">Could not load — please refresh.</div>'; });

  function pick(t) {
    S.tpl = t;
    document.querySelectorAll(".cyo-card").forEach(function (el) { el.classList.toggle("sel", el.dataset.id === t.id); });
    $("cyo-chosen").innerHTML = '<img src="' + t.thumbUrl + '" style="width:56px;height:56px;border-radius:10px;object-fit:cover"><div><b></b><div style="color:#f68b1e;font-weight:800;font-size:13px"></div></div>';
    $("cyo-chosen").querySelector("b").textContent = t.title;
    $("cyo-chosen").querySelector("div > div").textContent = t.price || "";
    $("cyo-cart-price").textContent = t.price ? "· " + t.price : "";
    show(2); check();
    try { history.replaceState(null, "", location.pathname + "?template=" + t.id); } catch (e) {}
  }
  $("cyo-back1").addEventListener("click", function (e) { e.preventDefault(); show(1); });

  // ── STEP 2: ảnh (downscale client-side ≤1024px JPEG để payload nhẹ) ──
  $("cyo-drop").addEventListener("click", function () { $("cyo-file").click(); });
  $("cyo-file").addEventListener("change", function () {
    var f = this.files && this.files[0]; if (!f) return;
    var img = new Image();
    img.onload = function () {
      var mx = 1024, w = img.width, h = img.height, k = Math.min(1, mx / Math.max(w, h));
      var c = document.createElement("canvas"); c.width = Math.round(w * k); c.height = Math.round(h * k);
      c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
      S.photo = c.toDataURL("image/jpeg", 0.87);
      $("cyo-drop-empty").style.display = "none";
      var full = $("cyo-drop-full"); full.style.display = ""; full.innerHTML = '<img src="' + S.photo + '"><span style="font-size:13px">✓ Photo added — click to change</span>';
      check();
    };
    img.onerror = function () { err("cyo-err2", "Could not read that image — please try another photo."); };
    img.src = URL.createObjectURL(f);
  });
  $("cyo-name").addEventListener("input", check);
  function check() { $("cyo-gen-btn").disabled = !(S.tpl && S.photo && $("cyo-name").value.trim()); }

  // ── STEP 3: generate ──
  $("cyo-gen-btn").addEventListener("click", function () {
    err("cyo-err2", "");
    show(3); S.t0 = Date.now();
    var bar = $("cyo-bar-i"), stages = ["Reading the photo…", "Painting the artwork…", "Adding the name…", "Final touches…"];
    S.timer = setInterval(function () {
      var s = Math.round((Date.now() - S.t0) / 1000);
      $("cyo-elapsed").textContent = s + "s";
      bar.style.width = Math.min(94, s * 1.6) + "%";
      $("cyo-gen-title").textContent = stages[Math.min(stages.length - 1, Math.floor(s / 18))];
    }, 900);
    fetch(API + "/generate", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ templateId: S.tpl.id, name: $("cyo-name").value.trim(), photo: S.photo }),
    }).then(function (r) { return r.json(); }).then(function (j) {
      clearInterval(S.timer);
      if (!j.ok) { show(2); err("cyo-err2", j.error || "Generation failed — please try again."); return; }
      S.previewId = j.previewId; S.previewUrl = j.url;
      $("cyo-result").src = j.url; show(4);
    }).catch(function () { clearInterval(S.timer); show(2); err("cyo-err2", "Network error — please try again."); });
  });

  // ── STEP 4: save email + add to cart ──
  $("cyo-save-btn").addEventListener("click", function () {
    err("cyo-err4", "");
    var email = $("cyo-email").value.trim();
    if (!email) { err("cyo-err4", "Please enter your email."); return; }
    fetch(API + "/lead", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ previewId: S.previewId, email: email }) })
      .then(function (r) { return r.json(); }).then(function (j) {
        if (j.ok) { $("cyo-save-note").style.display = ""; } else err("cyo-err4", j.error || "Could not save.");
      }).catch(function () { err("cyo-err4", "Network error."); });
  });
  $("cyo-cart-btn").addEventListener("click", function () {
    err("cyo-err4", "");
    if (!S.tpl.variantId) { err("cyo-err4", "This book is not available for online ordering yet — please contact us."); return; }
    var props = { "Child's Name": $("cyo-name").value.trim(), "_Studio Preview": S.previewUrl, "_Studio Preview Id": S.previewId };
    if ($("cyo-age").value) props["Child's Age"] = $("cyo-age").value;
    fetch("/cart/add.js", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: Number(S.tpl.variantId), quantity: 1, properties: props }),
    }).then(function (r) { return r.json(); }).then(function (j) {
      if (j && (j.id || (j.items && j.items.length))) location.href = "/cart";
      else err("cyo-err4", (j && j.description) || "Could not add to cart.");
    }).catch(function () { err("cyo-err4", "Could not add to cart — please try again."); });
  });
  $("cyo-retry").addEventListener("click", function (e) { e.preventDefault(); show(2); });
})();
</script>
