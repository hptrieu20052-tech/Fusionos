            <div><label class="cyo-lbl">Child's Age</label>
              <select class="cyo-inp" id="cyo-age"><option value="">—</option>
                <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option>
                <option>7</option><option>8</option><option>9</option><option>10</option><option>11</option><option>12</option>
              </select>
            </div>
          </div>
        </div>
        <div class="cyo-err" id="cyo-err2"></div>
        <div class="cyo-actions">
          <button class="cyo-btn big" id="cyo-gen-btn" disabled>Preview Book</button>
          <div class="cyo-priv" style="justify-content:center"><svg class="ic" style="width:17px;height:17px;margin-top:2px"><use href="#ic-lock"/></svg> <span><b>Private and secure, no third-party data use.</b> Your images and information stay protected.</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- STEP 3: MY BOOK -->
  <div id="cyo-s3" style="display:none">
    <div class="cyo-mb-head">
      <div>
        <h2 id="cyo-mb-title"></h2>
        <div class="cyo-mb-sub" id="cyo-mb-sub"></div>
      </div>
      <button class="cyo-btn alt" id="cyo-change" style="padding:11px 22px;font-size:13.5px">Change ▾</button>
    </div>

    <div class="cyo-box" id="cyo-covers-box" style="display:none">
      <h3>Choose cover options</h3>
      <div class="cyo-covers" id="cyo-covers"></div>
    </div>

    <div class="cyo-box cyo-emailrow">
      <div class="et"><b>Want us to save this preview?</b> Enter your email, and we'll send it your way!</div>
      <div class="ef">
        <input class="cyo-inp" id="cyo-email" type="email" placeholder="Email Address">
        <button class="cyo-btn alt" id="cyo-save-btn" style="padding:12px 20px;font-size:13.5px">Save</button>
      </div>
      <div class="cyo-note" id="cyo-save-note" style="display:none;flex-basis:100%">✓ Saved — we'll keep this preview for you.</div>
    </div>

    <div class="cyo-box">
      <div class="cyo-stagewrap">
        <img id="cyo-result" alt="Your personalized cover">
        <div class="cyo-genover" id="cyo-genover">
          <div class="gt">Just a moment while we bring your story to life…</div>
          <div class="cyo-bar"><i id="cyo-bar-i"></i></div>
          <div class="ge" id="cyo-elapsed">0s · usually 30–60 seconds</div>
        </div>
      </div>
    </div>

    <div class="cyo-err" id="cyo-err4"></div>
    <div class="cyo-actions">
      <button class="cyo-btn" id="cyo-cart-btn" disabled>Continue — Order <span id="cyo-cart-price"></span> →</button><br>
      <a href="#" id="cyo-retry" class="cyo-back">↻ Try a different photo</a>
    </div>
    <div class="cyo-note" style="text-align:center">The watermark is removed on the printed book. You'll review and approve your book before we print — changes are free at that stage.</div>
  </div>
</div>

<script>
(function () {
  // ⚙️ CHỈNH 1 DÒNG NÀY nếu domain FUSION thay đổi:
  var API = "https://os.fusiondn.com/api/studio/public";

  var S = { templates: [], tpl: null, photo: "", previewId: "", previewUrl: "", timer: null, t0: 0, chosenVariant: "", pendingEmail: "" };
  var $ = function (id) { return document.getElementById(id); };
  function show(step) {
    ["cyo-s1", "cyo-s2", "cyo-s3"].forEach(function (id, i) { $(id).style.display = (i === step - 1) ? "" : "none"; });
    document.querySelectorAll(".cyo-step").forEach(function (el) { el.classList.toggle("on", Number(el.dataset.step) <= step); });
    window.scrollTo({ top: 0, behavior: "smooth" });
  }
  function err(id, m) { var el = $(id); el.textContent = m || ""; el.style.display = m ? "" : "none"; }

  // ── STEP 1: load templates (?template=<id> → mở thẳng chi tiết) ──
  fetch(API).then(function (r) { return r.json(); }).then(function (j) {
    var box = $("cyo-templates");
    if (!j.ok || !j.templates || !j.templates.length) { box.innerHTML = '<div style="color:var(--cyo-muted)">Our studio is temporarily unavailable — please check back soon.</div>'; return; }
    S.templates = j.templates;
    box.innerHTML = "";
    j.templates.forEach(function (t) {
      var d = document.createElement("div");
      d.className = "cyo-card"; d.dataset.id = t.id;
      d.innerHTML = '<div class="imgwrap"><img src="' + t.thumbUrl + '" alt="" loading="lazy"></div><div class="t"></div><div class="p">From <b></b></div><span class="go">Personalize Now</span>';
      d.querySelector(".t").textContent = t.title;
      d.querySelector(".p b").textContent = t.price || "";
      d.addEventListener("click", function () { pick(t); });
      box.appendChild(d);
    });
    var pre = new URLSearchParams(location.search).get("template");
    if (pre) { var m = j.templates.filter(function (t) { return t.id === pre; })[0]; if (m) pick(m); }
  }).catch(function () { $("cyo-templates").innerHTML = '<div style="color:var(--cyo-muted)">Could not load — please refresh.</div>'; });

  // ── STEP 2: trang chi tiết + Start Personalizing ──
  function pick(t) {
    S.tpl = t; S.chosenVariant = t.variantId;
    $("cyo-d-img").src = t.thumbUrl;
    $("cyo-d-title").textContent = t.title;
    $("cyo-d-price").textContent = t.price || "";
    var de = $("cyo-d-desc");
    if (t.description && t.description.trim()) { de.textContent = t.description; de.style.display = ""; } else de.style.display = "none";
    var ag = $("cyo-d-ages");
    if (t.ageRange) { ag.querySelector("span").innerHTML = "Perfect for kids ages <b>" + t.ageRange + "</b> years old"; ag.style.display = "flex"; } else ag.style.display = "none";
    var pg = $("cyo-d-pages");
    if (t.pages) { pg.querySelector("span").innerHTML = "<b>" + t.pages + "</b> beautifully illustrated pages"; pg.style.display = "flex"; } else pg.style.display = "none";
    show(2); check();
    try { history.replaceState(null, "", location.pathname + "?template=" + t.id); } catch (e) {}
  }
  $("cyo-d-start").addEventListener("click", function () {
    $("cyo-start").scrollIntoView({ behavior: "smooth", block: "start" });
  });
  $("cyo-back1").addEventListener("click", function (e) { e.preventDefault(); show(1); });

  // Ảnh: upload → avatar tròn có nút ✕ (kiểu WonderWraps). Bấm avatar = đổi ảnh.
  $("cyo-drop").addEventListener("click", function () { $("cyo-file").click(); });
  $("cyo-avatar-img").addEventListener("click", function () { $("cyo-file").click(); });
  $("cyo-avatar-x").addEventListener("click", function () {
    S.photo = ""; $("cyo-file").value = "";
    $("cyo-avatar").style.display = "none";
    $("cyo-drop").style.display = ""; $("cyo-drophint").style.display = "";
    check();
  });
  $("cyo-file").addEventListener("change", function () {
    var f = this.files && this.files[0]; if (!f) return;
    var img = new Image();
    img.onload = function () {
      var mx = 1024, w = img.width, h = img.height, k = Math.min(1, mx / Math.max(w, h));
      var c = document.createElement("canvas"); c.width = Math.round(w * k); c.height = Math.round(h * k);
      c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
      S.photo = c.toDataURL("image/jpeg", 0.87);
      $("cyo-avatar-img").src = S.photo;
      $("cyo-avatar").style.display = "block";
      $("cyo-drop").style.display = "none"; $("cyo-drophint").style.display = "none";
      check();
    };
    img.onerror = function () { err("cyo-err2", "Could not read that image — please try another photo."); };
    img.src = URL.createObjectURL(f);
  });
  $("cyo-name").addEventListener("input", check);
  function check() { $("cyo-gen-btn").disabled = !(S.tpl && S.photo && $("cyo-name").value.trim()); }

  // ── MY BOOK ──
  function variantOf(id) {
    var vars = (S.tpl && S.tpl.variants || []).filter(function (v) { return v && v.id; });
    return vars.filter(function (x) { return x.id === id; })[0] || { id: S.tpl ? S.tpl.variantId : "", title: "", price: S.tpl ? S.tpl.price : "" };
  }
  function syncPrice() {
    var v = variantOf(S.chosenVariant);
    $("cyo-cart-price").textContent = v.price ? "· " + v.price : "";
  }
  function buildMyBook() {
    var name = $("cyo-name").value.trim(), age = $("cyo-age").value;
    $("cyo-mb-title").textContent = S.tpl.title;
    $("cyo-mb-sub").textContent = "First Name: " + name + (age ? " | Age: " + age : "");
    var vars = (S.tpl.variants || []).filter(function (v) { return v && v.id; });
    var box = $("cyo-covers-box"), list = $("cyo-covers");
    if (vars.length > 1) {
      list.innerHTML = "";
      vars.forEach(function (v, i) {
        var d = document.createElement("div");
        d.className = "cyo-cover" + (v.id === S.chosenVariant ? " sel" : "");
        d.dataset.vid = v.id;
        d.innerHTML = '<span class="tick">✓</span>' + (v.id === S.tpl.variantId ? '<span class="best">BEST CHOICE</span>' : "") +
          '<img src="' + S.tpl.thumbUrl + '" alt=""><div><div class="vt"></div><div class="vp"></div></div>';
        d.querySelector(".vt").textContent = v.title || ("Option " + (i + 1));
        d.querySelector(".vp").textContent = v.price || "";
        d.addEventListener("click", function () {
          S.chosenVariant = v.id;
          list.querySelectorAll(".cyo-cover").forEach(function (el) { el.classList.toggle("sel", el.dataset.vid === v.id); });
          syncPrice();
        });
        list.appendChild(d);
      });
      box.style.display = "";
    } else { box.style.display = "none"; }
    syncPrice();
  }
  $("cyo-change").addEventListener("click", function () { clearInterval(S.timer); show(2); });
  $("cyo-retry").addEventListener("click", function (e) { e.preventDefault(); clearInterval(S.timer); show(2); });

  // ── PREVIEW BOOK → My Book, preview mờ trong lúc gen ──
  $("cyo-gen-btn").addEventListener("click", function () {
    err("cyo-err2", ""); err("cyo-err4", "");
    buildMyBook();
    var img = $("cyo-result");
    img.src = S.tpl.thumbUrl; img.className = "blur";
    $("cyo-genover").style.display = ""; $("cyo-cart-btn").disabled = true;
    show(3); S.t0 = Date.now();
    S.timer = setInterval(function () {
      var s = Math.round((Date.now() - S.t0) / 1000);
      $("cyo-elapsed").textContent = s + "s · usually 30–60 seconds";
      $("cyo-bar-i").style.width = Math.min(94, s * 1.6) + "%";
    }, 900);
    fetch(API + "/generate", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ templateId: S.tpl.id, name: $("cyo-name").value.trim(), photo: S.photo }),
    }).then(function (r) { return r.json(); }).then(function (j) {
      clearInterval(S.timer);
      if (!j.ok) { show(2); err("cyo-err2", j.error || "Generation failed — please try again."); return; }
      S.previewId = j.previewId; S.previewUrl = j.url;
      img.src = j.url; img.className = "";
      $("cyo-genover").style.display = "none";
      $("cyo-cart-btn").disabled = false;
      if (S.pendingEmail) sendLead(S.pendingEmail);
    }).catch(function () { clearInterval(S.timer); show(2); err("cyo-err2", "Network error — please try again."); });
  });

  // ── EMAIL (nhập được trong lúc gen — xếp hàng gửi khi xong) ──
  function sendLead(email) {
    fetch(API + "/lead", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ previewId: S.previewId, email: email }) })
      .then(function (r) { return r.json(); }).then(function (j) {
        if (j.ok) { $("cyo-save-note").style.display = ""; S.pendingEmail = ""; }
        else err("cyo-err4", j.error || "Could not save.");
      }).catch(function () { err("cyo-err4", "Network error."); });
  }
  $("cyo-save-btn").addEventListener("click", function () {
    err("cyo-err4", "");
    var email = $("cyo-email").value.trim();
    if (!email) { err("cyo-err4", "Please enter your email."); return; }
    if (!S.previewId) { S.pendingEmail = email; $("cyo-save-note").style.display = ""; return; }
    sendLead(email);
  });

  // ── ORDER ──
  $("cyo-cart-btn").addEventListener("click", function () {
    err("cyo-err4", "");
    var vid = S.chosenVariant || (S.tpl && S.tpl.variantId);
    if (!vid) { err("cyo-err4", "This book is not available for online ordering yet — please contact us."); return; }
    var props = { "Child's Name": $("cyo-name").value.trim(), "_Studio Preview": S.previewUrl, "_Studio Preview Id": S.previewId };
    if ($("cyo-age").value) props["Child's Age"] = $("cyo-age").value;
    fetch("/cart/add.js", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id: Number(vid), quantity: 1, properties: props }),
    }).then(function (r) { return r.json(); }).then(function (j) {
      if (j && (j.id || (j.items && j.items.length))) location.href = "/cart";
      else err("cyo-err4", (j && j.description) || "Could not add to cart.");
    }).catch(function () { err("cyo-err4", "Could not add to cart — please try again."); });
  });
})();
</script>
