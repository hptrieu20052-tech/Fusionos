  <style>
    .ic { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
    :root { --cyo-orange: #f68b1e; --cyo-brown: #b06a30; --cyo-ink: #2d2a26; --cyo-muted: #8a8f98; --cyo-cream: #fdf8f1; --cyo-line: #f0e6d8; }
    #cyo-app { max-width: 1080px; margin: 0 auto; padding: 28px 16px 70px; font-family: inherit; color: var(--cyo-ink); }
    #cyo-app * { box-sizing: border-box; }
    .cyo-head { text-align: center; margin-bottom: 10px; }
    .cyo-head h1 { font-size: 34px; margin: 0 0 10px; color: var(--cyo-brown); font-weight: 800; }
    .cyo-head p { color: var(--cyo-muted); margin: 0; font-size: 15.5px; }
    .cyo-steps { display: flex; justify-content: center; gap: 8px; margin: 20px 0 30px; flex-wrap: wrap; }
    .cyo-step { font-size: 12.5px; font-weight: 700; padding: 7px 16px; border-radius: 99px; background: #f4efe6; color: #b9b2a6; }
    .cyo-step.on { background: var(--cyo-orange); color: #fff; box-shadow: 0 4px 14px rgba(246,139,30,.3); }
    .cyo-btn { display: inline-block; background: var(--cyo-orange); color: #fff !important; border: 0; border-radius: 99px; padding: 15px 34px; font-size: 15.5px; font-weight: 700; cursor: pointer; text-decoration: none; box-shadow: 0 6px 18px rgba(246,139,30,.28); }
    .cyo-btn[disabled] { opacity: .45; cursor: not-allowed; box-shadow: none; }
    .cyo-btn.alt { background: var(--cyo-ink); box-shadow: none; }
    .cyo-btn.big { width: 100%; text-align: center; }
    .cyo-note { font-size: 12.5px; color: var(--cyo-muted); margin-top: 10px; }
    .cyo-err { background: #fdecec; color: #c0392b; border-radius: 10px; padding: 10px 14px; font-size: 13.5px; margin-top: 12px; display: none; }
    .cyo-back { font-size: 13px; color: var(--cyo-muted); display: inline-block; margin-top: 14px; }
    .cyo-actions { text-align: center; margin-top: 22px; }
    .cyo-inp { width: 100%; padding: 13px 16px; border: 1px solid #e4dccd; border-radius: 14px; font-size: 15px; background: #fff; }
    .cyo-lbl { display: block; font-weight: 800; font-size: 13.5px; margin: 14px 0 6px; }

    /* ── STEP 1 · lưới sách ─────────────────────────────────────── */
    .cyo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 26px; }
    .cyo-card { cursor: pointer; text-align: center; transition: transform .15s, box-shadow .15s; background: #fff; border-radius: 18px; padding: 14px 14px 18px; box-shadow: 0 6px 22px rgba(45,42,38,.08); }
    .cyo-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(45,42,38,.13); }
    .cyo-card .imgwrap { border-radius: 12px; overflow: hidden; }
    .cyo-card img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
    .cyo-card .t { font-weight: 700; font-size: 15.5px; margin: 13px 0 5px; line-height: 1.4; }
    .cyo-card .p { font-size: 14px; color: var(--cyo-muted); margin-bottom: 12px; }
    .cyo-card .p b { color: var(--cyo-orange); font-size: 16.5px; font-weight: 800; }
    .cyo-card .go { display: inline-block; border: 1.5px solid var(--cyo-orange); color: var(--cyo-orange); border-radius: 99px; padding: 10px 24px; font-size: 13.5px; font-weight: 700; background: #fff; }
    .cyo-card:hover .go { background: var(--cyo-orange); color: #fff; }
    .cyo-trust { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-top: 42px; color: var(--cyo-muted); font-size: 13px; font-weight: 700; }
    .cyo-trust span { display: flex; align-items: center; gap: 7px; }

    /* ── STEP 2 · CHI TIẾT SÁCH + Start Personalizing ───────────── */
    .cyo-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; margin-bottom: 34px; }
    .cyo-detail .dimg { border-radius: 18px; box-shadow: 0 10px 30px rgba(45,42,38,.12); overflow: hidden; background: #fff; padding: 14px; }
    .cyo-detail .dimg img { width: 100%; display: block; border-radius: 12px; }
    .cyo-detail h2 { font-size: 30px; margin: 0 0 12px; font-weight: 800; line-height: 1.25; color: var(--cyo-brown); }
    .cyo-detail .dprice { font-size: 15px; color: var(--cyo-muted); margin: 14px 0 18px; }
    .cyo-detail .dprice b { color: var(--cyo-orange); font-size: 24px; font-weight: 800; }
    .cyo-detail .ddesc { color: #555; font-size: 15px; line-height: 1.7; margin-bottom: 18px; }
    .cyo-bullets { list-style: none; padding: 0; margin: 0 0 22px; }
    .cyo-bullets li { display: flex; gap: 9px; align-items: flex-start; font-size: 14.5px; margin-bottom: 9px; }
    .cyo-faq { border-top: 1px solid var(--cyo-line); }
    .cyo-faq details { border-bottom: 1px solid var(--cyo-line); }
    .cyo-faq summary { cursor: pointer; font-weight: 800; font-size: 14.5px; padding: 13px 2px; list-style: none; display: flex; justify-content: space-between; }
    .cyo-faq summary::after { content: "▾"; color: var(--cyo-muted); }
    .cyo-faq p { margin: 0 0 14px; font-size: 13.5px; color: #666; line-height: 1.65; }
    .cyo-wrap2 { background: var(--cyo-cream); border-radius: 22px; padding: 34px 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-items: start; }
    .cyo-left h2 { font-size: 30px; margin: 0 0 10px; font-weight: 800; color: var(--cyo-brown); }
    .cyo-left .sub { color: var(--cyo-muted); font-size: 15px; line-height: 1.6; margin-bottom: 26px; }
    .cyo-flow3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; }
    .cyo-flow3 .f { font-size: 12px; font-weight: 700; color: var(--cyo-muted); line-height: 1.4; }
    .cyo-flow3 .c { width: 84px; height: 84px; margin: 0 auto 8px; border-radius: 50%; border: 2px dashed #e4d5bd; display: flex; align-items: center; justify-content: center; background: #fff; position: relative; padding: 3px; }
    .cyo-flow3 .n { position: absolute; bottom: -6px; left: 50%; transform: translateX(-50%); background: var(--cyo-orange); color: #fff; width: 20px; height: 20px; border-radius: 50%; font-size: 11px; line-height: 20px; font-weight: 900; }
    .cyo-tips { background: #fff; border: 1px solid var(--cyo-line); border-radius: 18px; padding: 20px; }
    .cyo-tips .tt { text-align: center; font-weight: 800; letter-spacing: 3px; font-size: 13px; margin-bottom: 14px; }
    .cyo-tipsrow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; text-align: center; margin-bottom: 18px; }
    .cyo-tip .c { width: 62px; height: 62px; margin: 0 auto 6px; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; background: #faf4ea; }
    .cyo-tip .c img, .cyo-flow3 .c img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
    .cyo-tip.ok .c { border: 2.5px solid #2e9e5b; } .cyo-tip.no .c { border: 2.5px solid #d9534f; }
    .cyo-tip .m { position: absolute; top: -4px; right: -4px; width: 18px; height: 18px; border-radius: 50%; color: #fff; font-size: 11px; line-height: 18px; font-weight: 900; }
    .cyo-tip.ok .m { background: #2e9e5b; } .cyo-tip.no .m { background: #d9534f; }
    .cyo-tip .d { font-size: 11px; color: var(--cyo-muted); font-weight: 700; line-height: 1.35; }
    .cyo-upload { display: block; width: 100%; background: var(--cyo-orange); color: #fff; border: 0; border-radius: 99px; padding: 16px; font-size: 16.5px; font-weight: 800; cursor: pointer; text-align: center; box-shadow: 0 6px 18px rgba(246,139,30,.35); }
    .cyo-drophint { text-align: center; font-size: 12.5px; color: var(--cyo-muted); font-weight: 700; margin-top: 8px; }
    .cyo-avatar { position: relative; width: 128px; margin: 0 auto; display: none; }
    .cyo-avatar img { width: 128px; height: 128px; border-radius: 50%; object-fit: cover; border: 3px solid #fff; box-shadow: 0 6px 18px rgba(45,42,38,.2); cursor: pointer; }
    .cyo-avatar .x { position: absolute; top: 0; right: 0; width: 28px; height: 28px; border-radius: 50%; background: #fff; border: 1px solid var(--cyo-line); font-size: 13px; font-weight: 900; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
    .cyo-priv { display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; color: var(--cyo-muted); margin-top: 14px; line-height: 1.5; }

    /* ── STEP 3 · MY BOOK ────────────────────────────────────────── */
    .cyo-mb-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
    .cyo-mb-head h2 { font-size: 26px; margin: 0 0 4px; font-weight: 800; }
    .cyo-mb-sub { color: var(--cyo-muted); font-size: 14px; font-weight: 600; }
    .cyo-box { background: #fff; border: 1px solid var(--cyo-line); border-radius: 18px; padding: 22px; margin-bottom: 16px; }
    .cyo-box h3 { margin: 0 0 16px; font-size: 19px; font-weight: 800; }
    .cyo-covers { display: flex; gap: 16px; flex-wrap: wrap; }
    .cyo-cover { position: relative; display: flex; gap: 14px; align-items: center; border: 2px solid var(--cyo-line); border-radius: 16px; padding: 14px 18px 14px 14px; cursor: pointer; min-width: 260px; flex: 0 1 320px; background: #fff; transition: border-color .15s; }
    .cyo-cover:hover { border-color: #f6b26e; }
    .cyo-cover.sel { border-color: var(--cyo-orange); background: #fff8f0; box-shadow: 0 0 0 3px rgba(246,139,30,.12); }
    .cyo-cover img { width: 84px; height: 84px; border-radius: 10px; object-fit: cover; }
    .cyo-cover .vt { font-weight: 800; font-size: 15.5px; margin-bottom: 3px; }
    .cyo-cover .vp { color: var(--cyo-orange); font-weight: 800; font-size: 16px; margin-top: 6px; }
    .cyo-cover .tick { position: absolute; top: -9px; left: -9px; width: 24px; height: 24px; border-radius: 50%; background: var(--cyo-orange); color: #fff; font-size: 13px; line-height: 24px; text-align: center; font-weight: 900; display: none; }
    .cyo-cover.sel .tick { display: block; }
    .cyo-cover .best { position: absolute; top: -11px; right: 14px; background: #e8474b; color: #fff; font-size: 10.5px; font-weight: 900; letter-spacing: .5px; padding: 4px 10px; border-radius: 7px; }
    .cyo-emailrow { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
    .cyo-emailrow .et { flex: 1 1 260px; font-size: 14.5px; line-height: 1.5; }
    .cyo-emailrow .ef { display: flex; gap: 8px; flex: 1 1 300px; }
    .cyo-stagewrap { position: relative; max-width: 560px; margin: 0 auto; }
    .cyo-stagewrap img { width: 100%; border-radius: 14px; box-shadow: 0 10px 30px rgba(45,42,38,.14); display: block; }
    .cyo-stagewrap img.blur { filter: blur(14px) saturate(.9); }
    .cyo-genover { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 20px; }
    .cyo-genover .gt { font-size: 19px; font-weight: 800; color: #fff; text-shadow: 0 2px 14px rgba(0,0,0,.45); }
    .cyo-bar { height: 8px; background: rgba(255,255,255,.45); border-radius: 99px; overflow: hidden; width: 70%; max-width: 320px; }
    .cyo-bar i { display: block; height: 100%; width: 0%; background: var(--cyo-orange); border-radius: 99px; transition: width .8s ease; }
    .cyo-genover .ge { font-size: 12px; color: #fff; font-weight: 700; text-shadow: 0 1px 8px rgba(0,0,0,.4); }

    @media (max-width: 760px) {
      .cyo-detail, .cyo-wrap2 { grid-template-columns: 1fr; }
      .cyo-wrap2 { padding: 22px 16px; }
      .cyo-head h1 { font-size: 26px; }
      .cyo-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }
      .cyo-card .t { font-size: 14px; }
      .cyo-cover { flex: 1 1 100%; }
    }
  </style>

  <div class="cyo-head">
    <h1>Create Your Own Storybook</h1>
    <p>Make your child the hero of their favorite story — see their cover in about a minute. Free, no card needed.</p>
    <div class="cyo-steps">
      <span class="cyo-step" data-step="1">1 · Choose a book</span>
      <span class="cyo-step" data-step="2">2 · Personalize</span>
      <span class="cyo-step" data-step="3">3 · Your book</span>
    </div>
  </div>

  <!-- STEP 1: lưới sách -->
  <div id="cyo-s1">
    <div class="cyo-grid" id="cyo-templates"><div style="color:var(--cyo-muted)">Loading books…</div></div>
    <div class="cyo-trust">
      <span><svg class="ic" style="width:17px;height:17px"><use href="#ic-truck"/></svg> Free US shipping</span>
      <span><svg class="ic" style="width:17px;height:17px"><use href="#ic-eye"/></svg> Review &amp; approve before we print</span>
      <span><svg class="ic" style="width:17px;height:17px"><use href="#ic-lock"/></svg> Secure checkout</span>
    </div>
  </div>

  <!-- STEP 2: CHI TIẾT SÁCH + Start Personalizing (kiểu product page WonderWraps) -->
  <div id="cyo-s2" style="display:none">
    <div class="cyo-detail">
      <div class="dimg"><img id="cyo-d-img" alt=""></div>
      <div>
        <h2 id="cyo-d-title"></h2>
        <div class="ddesc" id="cyo-d-desc" style="display:none"></div>
        <ul class="cyo-bullets">
          <li id="cyo-d-ages" style="display:none"><svg class="ic" style="width:19px;height:19px;margin-top:1px"><use href="#ic-smile"/></svg> <span></span></li>
          <li id="cyo-d-pages" style="display:none"><svg class="ic" style="width:19px;height:19px;margin-top:1px"><use href="#ic-book"/></svg> <span></span></li>
          <li><svg class="ic" style="width:19px;height:19px;margin-top:1px"><use href="#ic-eye"/></svg> <span><b>Preview</b> available before ordering — free, no card needed</span></li>
          <li><svg class="ic" style="width:19px;height:19px;margin-top:1px;color:#2e9e5b"><use href="#ic-check"/></svg> <span>You'll <b>review &amp; approve</b> your book before we print</span></li>
        </ul>
        <div class="dprice">From <b id="cyo-d-price"></b></div>
        <button class="cyo-btn big" id="cyo-d-start">Personalize my book</button>
        <div class="cyo-faq" style="margin-top:22px">
          <details><summary>How is the book personalized for my child?</summary><p>Upload one clear photo and enter your child's name — we redraw the main character with your child's face in the book's art style, and print their name on the cover. You'll see a free preview before ordering.</p></details>
          <details><summary>What if I need changes after ordering?</summary><p>After your order, you review and approve the book before we print. Changes at that stage are free.</p></details>
        </div>
        <a href="#" id="cyo-back1" class="cyo-back">← Choose a different book</a>
      </div>
    </div>

    <!-- Start Personalizing -->
    <div class="cyo-wrap2" id="cyo-start">
      <div class="cyo-left">
        <h2>Start Personalizing</h2>
        <div class="sub">Personalize the storybook with your child's photo. Preview the cover, place your order, and we'll print and deliver it to your home.</div>
        <div class="cyo-flow3">
          <div><div class="c"><img src="data:image/jpeg;base64," alt=""><span class="n">1</span></div><div class="f">Upload Child's Picture</div></div>
          <div><div class="c"><img src="data:image/jpeg;base64," alt=""><span class="n">2</span></div><div class="f">Preview Book and Order</div></div>
          <div><div class="c"><img src="data:image/jpeg;base64," alt=""><span class="n">3</span></div><div class="f">Premium Print, Delivered to Your Door</div></div>
        </div>
      </div>

      <div>
        <div class="cyo-tips">
          <div class="tt">T I P S</div>
          <div class="cyo-tipsrow">
            <div class="cyo-tip ok"><div class="c"><img src="data:image/jpeg;base64," alt="Clear front-facing photo"><span class="m">✓</span></div><div class="d">Clear front-facing photo</div></div>
            <div class="cyo-tip no"><div class="c"><img src="data:image/jpeg;base64," alt=""><span class="m">✕</span></div><div class="d">No eating or covered face</div></div>
            <div class="cyo-tip no"><div class="c"><img src="data:image/jpeg;base64," alt=""><span class="m">✕</span></div><div class="d">No hats or sunglasses</div></div>
            <div class="cyo-tip no"><div class="c"><img src="data:image/jpeg;base64," alt=""><span class="m">✕</span></div><div class="d">No far away or side angle</div></div>
          </div>
          <button class="cyo-upload" id="cyo-drop" type="button">Child's Photo <svg class="ic" style="width:19px;height:19px;vertical-align:-4px;margin-left:6px"><use href="#ic-up"/></svg></button>
          <div class="cyo-drophint" id="cyo-drophint">drop a photo or click the button</div>
          <div class="cyo-avatar" id="cyo-avatar"><img id="cyo-avatar-img" alt=""><button class="x" id="cyo-avatar-x" type="button">✕</button></div>
